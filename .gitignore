# PlatformIO build artifacts
.pio/

# Native ESP-IDF build environment and generated files
.tools/
build/
build-docker/
sdkconfig
sdkconfig.old

# Managed components — regenerated from idf_component.yml + dependencies.lock
managed_components/

# One-time ESP32-C6 coprocessor firmware update tooling (large build artifacts)
c6_update/

# VSCode generated files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# macOS
.DS_Store
**/.DS_Store

# Claude Code session data
.claude/

# Local credentials
src/secrets.h

# Machine-specific build/deploy config (copy from config.sample.env)
config.env

# Machine-specific Windows build/deploy config (copy from config.win.sample.ps1)
config.win.ps1

# Per-machine VS Code settings (absolute ESP-IDF / toolchain paths)
.vscode/settings.json

# Device-local HTTPS credentials + cert-generation byproducts
main/certs/*.pem
main/certs/*.srl
main/certs/*.csr
main/certs/*.cnf

# Bootstrap recovery firmware — generated lockfile and cert symlinks into main/certs/
bootstrap/dependencies.lock
bootstrap/main/*.pem
