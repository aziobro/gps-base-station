# GPS Base Station — local build/deploy configuration (SAMPLE)
#
# Copy this file to "config.env" and edit it for your machine:
#
#     cp config.sample.env config.env
#
# config.env is git-ignored, so your machine-specific paths, ports, and IPs
# never get committed. It is sourced by ./idf.sh, tools/release.sh, and
# tools/generate-https-certs.sh. Every value below is optional — each script
# falls back to a built-in default if the variable is unset, and a real
# environment variable (e.g. `PORT=/dev/ttyX ./idf.sh flash`) still wins over
# the value here.

# ----------------------------------------------------------------------------
# Build toolchain
# ----------------------------------------------------------------------------
# Absolute path to the RISC-V toolchain `bin` directory. It must match the
# toolchain installed for your ESP-IDF version. Find it under:
#   ~/.espressif/tools/riscv32-esp-elf/<version>/riscv32-esp-elf/bin
RISCV_TOOLCHAIN_BIN="$HOME/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/bin"

# ----------------------------------------------------------------------------
# Flashing / device
# ----------------------------------------------------------------------------
# Serial port used for USB flashing (`./idf.sh flash`, `tools/release.sh usb`).
# macOS: /dev/tty.usbmodem*   Linux: /dev/ttyUSB0 or /dev/ttyACM0
PORT="/dev/tty.usbmodem5B140747221"

# Device hostname or IP for OTA upload and live /status verification
# (tools/release.sh ota uses its positional HOST arg; this is the default for
# USB-mode verification).
DEVICE_HOST="192.168.8.186"

# Web UI / OTA admin username.
ADMIN_USER="admin"

# Admin password is intentionally NOT stored here. Pass it at run time:
#   ADMIN_PASSWORD=secret tools/release.sh ota "$DEVICE_HOST"
# (You *may* add `ADMIN_PASSWORD=...` below for convenience since config.env is
# git-ignored, but a prompt/env var is safer.)

# ----------------------------------------------------------------------------
# HTTPS server certificate (tools/generate-https-certs.sh)
# ----------------------------------------------------------------------------
# Subject Alternative Names baked into the server certificate. Use the device's
# mDNS name (IP-independent, the robust way to reach it) plus its current LAN IP
# and the SoftAP gateway IP. Browsers validate against these, so keep CERT_IP in
# sync with the device's DHCP address if you rely on IP-based HTTPS.
CERT_DNS="gps-base.local"
CERT_IP="192.168.8.186"
CERT_AP_IP="192.168.4.1"
